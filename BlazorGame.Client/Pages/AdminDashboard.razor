@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Bladebound · Administration</PageTitle>

<div class="admin-dashboard">
    <div class="admin-header mb-4">
        <h2><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-shield-fill-check" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.8 11.8 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7 7 0 0 0 1.048-.625 11.8 11.8 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 63 63 0 0 0-2.887-.87C9.843.266 8.69 0 8 0m2.146 5.146a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793z"/></svg> Administration</h2>
        <p class="text-muted">Gestion des joueurs et statistiques</p>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Onglets de navigation -->
        <ul class="nav nav-tabs mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "players" ? "active" : "")" @onclick='() => SetActiveTab("players")'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16">
                        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/>
                    </svg>
                    Joueurs (@players?.Count ?? 0)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "leaderboard" ? "active" : "")" @onclick='() => SetActiveTab("leaderboard")'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trophy-fill" viewBox="0 0 16 16">
                        <path d="M2.5.5A.5.5 0 0 1 3 0h10a.5.5 0 0 1 .5.5q0 .807-.034 1.536a3 3 0 1 1-1.133 5.89c-.79 1.865-1.878 2.777-2.833 3.011v2.173l1.425.356c.194.048.377.135.537.255L13.3 15.1a.5.5 0 0 1-.3.9H3a.5.5 0 0 1-.3-.9l1.838-1.379c.16-.12.343-.207.537-.255L6.5 13.11v-2.173c-.955-.234-2.043-1.146-2.833-3.012a3 3 0 1 1-1.132-5.89A33 33 0 0 1 2.5.5m.099 2.54a2 2 0 0 0 .72 3.935c-.333-1.05-.588-2.346-.72-3.935m10.083 3.935a2 2 0 0 0 .72-3.935c-.133 1.59-.388 2.885-.72 3.935"/>
                    </svg>
                    Classement
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "sessions" ? "active" : "")" @onclick='() => SetActiveTab("sessions")'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-controller" viewBox="0 0 16 16">
                        <path d="M11.5 6.027a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m-1.5 1.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1m2.5-.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m-1.5 1.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1m-6.5-3h1v1h1v1h-1v1h-1v-1h-1v-1h1z"/>
                        <path d="M3.051 3.26a.5.5 0 0 1 .354-.613l1.932-.518a.5.5 0 0 1 .62.39c.655-.079 1.35-.117 2.043-.117.72 0 1.443.041 2.12.126a.5.5 0 0 1 .622-.399l1.932.518a.5.5 0 0 1 .306.729q.211.136.373.297c.408.408.78 1.05 1.095 1.772.32.733.599 1.591.805 2.466s.34 1.78.364 2.606c.024.816-.059 1.602-.328 2.21a1.42 1.42 0 0 1-1.445.83c-.636-.067-1.115-.394-1.513-.773-.245-.232-.496-.526-.739-.808-.126-.148-.25-.292-.368-.423-.728-.804-1.597-1.527-3.224-1.527s-2.496.723-3.224 1.527c-.119.131-.242.275-.368.423-.243.282-.494.575-.739.808-.398.38-.877.706-1.513.773a1.42 1.42 0 0 1-1.445-.83c-.27-.608-.352-1.395-.329-2.21.024-.826.16-1.73.365-2.606.206-.875.486-1.733.805-2.466.315-.722.687-1.364 1.094-1.772a2.3 2.3 0 0 1 .433-.335l-.028-.079zm2.036.412c-.877.185-1.469.443-1.733.708-.276.276-.587.783-.885 1.465a14 14 0 0 0-.748 2.295 12.4 12.4 0 0 0-.339 2.406c-.022.755.062 1.368.243 1.776a.42.42 0 0 0 .426.24c.327-.034.61-.199.929-.502.212-.202.4-.423.615-.674.133-.156.276-.323.44-.504C4.861 9.969 5.978 9.027 8 9.027s3.139.942 3.965 1.855c.164.181.307.348.44.504.214.251.403.472.615.674.318.303.601.468.929.503a.42.42 0 0 0 .426-.241c.18-.408.265-1.02.243-1.776a12.4 12.4 0 0 0-.339-2.406 14 14 0 0 0-.748-2.295c-.298-.682-.61-1.19-.885-1.465-.264-.265-.856-.523-1.733-.708-.85-.179-1.877-.27-2.913-.27s-2.063.091-2.913.27"/>
                    </svg>
                    Parties (@sessions?.Count ?? 0)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "stats" ? "active" : "")" @onclick='() => SetActiveTab("stats")'>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bar-chart-fill" viewBox="0 0 16 16">
                        <path d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z"/>
                    </svg>
                    Statistiques
                </button>
            </li>
        </ul>

        <!-- Contenu des onglets -->
        <div class="tab-content">
            @if (activeTab == "players")
            {
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/></svg> Gestion des Joueurs</h5>
                        <div>
                            <button class="btn btn-sm btn-secondary" @onclick="LoadPlayers">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16"><path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41m-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9"/><path fill-rule="evenodd" d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5 5 0 0 0 8 3M3.1 9a5.002 5.002 0 0 0 8.757 2.182.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9z"/></svg> Actualiser
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (players == null || players.Count == 0)
                        {
                            <p class="text-center text-muted">Aucun joueur trouvé</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Santé</th>
                                            <th>Force</th>
                                            <th>Armure</th>
                                            <th>Dégâts</th>
                                            <th>Coeurs</th>
                                            <th>Statut</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var player in players)
                                        {
                                            <tr class="@(player.IsActive ? "" : "table-secondary")">
                                                <td><strong>@player.CharacterId</strong></td>
                                                <td>
                                                    <span class="badge @(player.Health > 0 ? "bg-success" : "bg-danger")">
                                                        @player.Health.ToString("F1")
                                                    </span>
                                                </td>
                                                <td>@player.Strength.ToString("F1")</td>
                                                <td>@player.Armor.ToString("F1")</td>
                                                <td>@player.Damage.ToString("F1")</td>
                                                <td><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314"/></svg> @player.HeartNumber</td>
                                                <td>
                                                    @if (player.IsActive)
                                                    {
                                                        <span class="badge bg-success">Actif</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactif</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-info" @onclick="() => ViewPlayerStats(player.CharacterId)" title="Voir les stats">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-graph-up" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M0 0h1v15h15v1H0zm14.817 3.113a.5.5 0 0 1 .07.704l-4.5 5.5a.5.5 0 0 1-.74.037L7.06 6.767l-3.656 5.027a.5.5 0 0 1-.808-.588l4-5.5a.5.5 0 0 1 .758-.06l2.609 2.61 4.15-5.073a.5.5 0 0 1 .704-.07"/></svg>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "leaderboard")
            {
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trophy-fill" viewBox="0 0 16 16"><path d="M2.5.5A.5.5 0 0 1 3 0h10a.5.5 0 0 1 .5.5q0 .807-.034 1.536a3 3 0 1 1-1.133 5.89c-.79 1.865-1.878 2.777-2.833 3.011v2.173l1.425.356c.194.048.377.135.537.255L13.3 15.1a.5.5 0 0 1-.3.9H3a.5.5 0 0 1-.3-.9l1.838-1.379c.16-.12.343-.207.537-.255L6.5 13.11v-2.173c-.955-.234-2.043-1.146-2.833-3.012a3 3 0 1 1-1.132-5.89A33 33 0 0 1 2.5.5m.099 2.54a2 2 0 0 0 .72 3.935c-.333-1.05-.588-2.346-.72-3.935m10.083 3.935a2 2 0 0 0 .72-3.935c-.133 1.59-.388 2.885-.72 3.935"/></svg> Classement Général</h5>
                        <button class="btn btn-sm btn-secondary" @onclick="LoadLeaderboard">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16"><path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41m-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9"/><path fill-rule="evenodd" d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5 5 0 0 0 8 3M3.1 9a5.002 5.002 0 0 0 8.757 2.182.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9z"/></svg> Actualiser
                        </button>
                    </div>
                    <div class="card-body">
                        @if (leaderboard == null || leaderboard.Count == 0)
                        {
                            <p class="text-center text-muted">Aucun classement disponible</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Rang</th>
                                            <th>Joueur</th>
                                            <th>Score Total</th>
                                            <th>Parties</th>
                                            <th>Victoires</th>
                                            <th>Défaites</th>
                                            <th>Meilleur Score</th>
                                            <th>Moyenne</th>
                                            <th>Dernière partie</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            int rank = 1;
                                        }
                                        @foreach (var entry in leaderboard)
                                        {
                                            <tr>
                                                <td>
                                                    @if (rank == 1) { <span class="badge bg-warning">1st @rank</span> }
                                                    else if (rank == 2) { <span class="badge bg-secondary">2nd @rank</span> }
                                                    else if (rank == 3) { <span class="badge bg-danger">3rd @rank</span> }
                                                    else { <strong>@rank</strong> }
                                                </td>
                                                <td><strong>Joueur #@entry.PlayerId</strong></td>
                                                <td><span class="badge bg-primary">@entry.TotalScore</span></td>
                                                <td>@entry.GamesPlayed</td>
                                                <td><span class="text-success">@entry.Victories</span></td>
                                                <td><span class="text-danger">@entry.Defeats</span></td>
                                                <td>@entry.BestScore</td>
                                                <td>@entry.AverageScore.ToString("F1")</td>
                                                <td><small>@entry.LastPlayed.ToString("dd/MM/yyyy")</small></td>
                                            </tr>
                                            rank++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "sessions")
            {
                <div class="card">
                    <div class="card-header">
                        <h5><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-controller" viewBox="0 0 16 16"><path d="M11.5 6.027a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m-1.5 1.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1m2.5-.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m-1.5 1.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1m-6.5-3h1v1h1v1h-1v1h-1v-1h-1v-1h1z"/><path d="M3.051 3.26a.5.5 0 0 1 .354-.613l1.932-.518a.5.5 0 0 1 .62.39c.655-.079 1.35-.117 2.043-.117.72 0 1.443.041 2.12.126a.5.5 0 0 1 .622-.399l1.932.518a.5.5 0 0 1 .306.729q.211.136.373.297c.408.408.78 1.05 1.095 1.772.32.733.599 1.591.805 2.466s.34 1.78.364 2.606c.024.816-.059 1.602-.328 2.21a1.42 1.42 0 0 1-1.445.83c-.636-.067-1.115-.394-1.513-.773-.245-.232-.496-.526-.739-.808-.126-.148-.25-.292-.368-.423-.728-.804-1.597-1.527-3.224-1.527s-2.496.723-3.224 1.527c-.119.131-.242.275-.368.423-.243.282-.494.575-.739.808-.398.38-.877.706-1.513.773a1.42 1.42 0 0 1-1.445-.83c-.27-.608-.352-1.395-.329-2.21.024-.826.16-1.73.365-2.606.206-.875.486-1.733.805-2.466.315-.722.687-1.364 1.094-1.772a2.3 2.3 0 0 1 .433-.335l-.028-.079zm2.036.412c-.877.185-1.469.443-1.733.708-.276.276-.587.783-.885 1.465a14 14 0 0 0-.748 2.295 12.4 12.4 0 0 0-.339 2.406c-.022.755.062 1.368.243 1.776a.42.42 0 0 0 .426.24c.327-.034.61-.199.929-.502.212-.202.4-.423.615-.674.133-.156.276-.323.44-.504C4.861 9.969 5.978 9.027 8 9.027s3.139.942 3.965 1.855c.164.181.307.348.44.504.214.251.403.472.615.674.318.303.601.468.929.503a.42.42 0 0 0 .426-.241c.18-.408.265-1.02.243-1.776a12.4 12.4 0 0 0-.339-2.406 14 14 0 0 0-.748-2.295c-.298-.682-.61-1.19-.885-1.465-.264-.265-.856-.523-1.733-.708-.85-.179-1.877-.27-2.913-.27s-2.063.091-2.913.27"/></svg> Liste des Parties</h5>
                    </div>
                    <div class="card-body">
                        @if (sessions == null || sessions.Count == 0)
                        {
                            <p class="text-center text-muted">Aucune partie trouvée</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th>Session ID</th>
                                            <th>Joueur</th>
                                            <th>Donjon</th>
                                            <th>Score</th>
                                            <th>Statut</th>
                                            <th>Créée le</th>
                                            <th>Mise à jour</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var session in sessions)
                                        {
                                            <tr>
                                                <td>@session.SessionId</td>
                                                <td>Joueur #@session.PlayerId</td>
                                                <td>Donjon #@session.DungeonId</td>
                                                <td><strong>@session.Score</strong></td>
                                                <td>
                                                    @{
                                                        var statusClass = session.Status switch
                                                        {
                                                            "Victory" => "bg-success",
                                                            "Defeat" => "bg-danger",
                                                            "InProgress" => "bg-info",
                                                            "Saved" => "bg-warning",
                                                            "Abandoned" => "bg-secondary",
                                                            _ => "bg-secondary"
                                                        };
                                                    }
                                                    <span class="badge @statusClass">@session.Status</span>
                                                </td>
                                                <td><small>@session.CreatedAt.ToString("dd/MM HH:mm")</small></td>
                                                <td><small>@session.UpdatedAt.ToString("dd/MM HH:mm")</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (activeTab == "stats")
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-header bg-primary text-white">
                                <h5><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-bar-chart-fill" viewBox="0 0 16 16"><path d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z"/></svg> Statistiques Globales</h5>
                            </div>
                            <div class="card-body">
                                @if (statistics != null)
                                {
                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value">@statistics.EntityCounts?.Rooms</div>
                                                <div class="stat-label">Salles</div>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value">@statistics.EntityCounts?.Players</div>
                                                <div class="stat-label">Joueurs</div>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value">@statistics.EntityCounts?.Monsters</div>
                                                <div class="stat-label">Monstres</div>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value">@statistics.EntityCounts?.Dungeons</div>
                                                <div class="stat-label">Donjons</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-header bg-success text-white">
                                <h5><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-people-fill" viewBox="0 0 16 16"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/></svg> Statistiques Joueurs</h5>
                            </div>
                            <div class="card-body">
                                @if (statistics?.PlayerStatistics != null)
                                {
                                    <div class="row">
                                        <div class="col-6 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value text-success">@statistics.PlayerStatistics.AlivePlayers</div>
                                                <div class="stat-label">En vie</div>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value text-danger">@statistics.PlayerStatistics.DeadPlayers</div>
                                                <div class="stat-label">Morts</div>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value">@statistics.PlayerStatistics.AverageHealth?.ToString("F1")</div>
                                                <div class="stat-label">Santé moy.</div>
                                            </div>
                                        </div>
                                        <div class="col-6 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value">@statistics.PlayerStatistics.AverageStrength?.ToString("F1")</div>
                                                <div class="stat-label">Force moy.</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <div class="card">
                            <div class="card-header bg-info text-white">
                                <h5><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-controller" viewBox="0 0 16 16"><path d="M11.5 6.027a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m-1.5 1.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1m2.5-.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m-1.5 1.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1m-6.5-3h1v1h1v1h-1v1h-1v-1h-1v-1h1z"/><path d="M3.051 3.26a.5.5 0 0 1 .354-.613l1.932-.518a.5.5 0 0 1 .62.39c.655-.079 1.35-.117 2.043-.117.72 0 1.443.041 2.12.126a.5.5 0 0 1 .622-.399l1.932.518a.5.5 0 0 1 .306.729q.211.136.373.297c.408.408.78 1.05 1.095 1.772.32.733.599 1.591.805 2.466s.34 1.78.364 2.606c.024.816-.059 1.602-.328 2.21a1.42 1.42 0 0 1-1.445.83c-.636-.067-1.115-.394-1.513-.773-.245-.232-.496-.526-.739-.808-.126-.148-.25-.292-.368-.423-.728-.804-1.597-1.527-3.224-1.527s-2.496.723-3.224 1.527c-.119.131-.242.275-.368.423-.243.282-.494.575-.739.808-.398.38-.877.706-1.513.773a1.42 1.42 0 0 1-1.445-.83c-.27-.608-.352-1.395-.329-2.21.024-.826.16-1.73.365-2.606.206-.875.486-1.733.805-2.466.315-.722.687-1.364 1.094-1.772a2.3 2.3 0 0 1 .433-.335l-.028-.079zm2.036.412c-.877.185-1.469.443-1.733.708-.276.276-.587.783-.885 1.465a14 14 0 0 0-.748 2.295 12.4 12.4 0 0 0-.339 2.406c-.022.755.062 1.368.243 1.776a.42.42 0 0 0 .426.24c.327-.034.61-.199.929-.502.212-.202.4-.423.615-.674.133-.156.276-.323.44-.504C4.861 9.969 5.978 9.027 8 9.027s3.139.942 3.965 1.855c.164.181.307.348.44.504.214.251.403.472.615.674.318.303.601.468.929.503a.42.42 0 0 0 .426-.241c.18-.408.265-1.02.243-1.776a12.4 12.4 0 0 0-.339-2.406 14 14 0 0 0-.748-2.295c-.298-.682-.61-1.19-.885-1.465-.264-.265-.856-.523-1.733-.708-.85-.179-1.877-.27-2.913-.27s-2.063.091-2.913.27"/></svg> Statistiques des Sessions</h5>
                            </div>
                            <div class="card-body">
                                @if (statistics?.SessionStatistics != null)
                                {
                                    <div class="row">
                                        <div class="col-md-3 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value text-info">@statistics.SessionStatistics.ActiveSessions</div>
                                                <div class="stat-label">En cours</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value text-success">@statistics.SessionStatistics.CompletedSessions</div>
                                                <div class="stat-label">Terminées</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value text-warning">@statistics.SessionStatistics.SavedSessions</div>
                                                <div class="stat-label">Sauvegardées</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3 mb-3">
                                            <div class="stat-box">
                                                <div class="stat-value text-secondary">@statistics.SessionStatistics.AbandonedSessions</div>
                                                <div class="stat-label">Abandonnées</div>
                                            </div>
                                        </div>
                                        <div class="col-md-12 text-center">
                                            <h4>Score moyen: <span class="badge bg-primary">@statistics.SessionStatistics.AverageScore?.ToString("F1")</span></h4>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/></svg> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/></svg> @successMessage
        </div>
    }

    <!-- Modal pour les stats d'un joueur -->
    @if (selectedPlayerStats != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-graph-up" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M0 0h1v15h15v1H0zm14.817 3.113a.5.5 0 0 1 .07.704l-4.5 5.5a.5.5 0 0 1-.74.037L7.06 6.767l-3.656 5.027a.5.5 0 0 1-.808-.588l4-5.5a.5.5 0 0 1 .758-.06l2.609 2.61 4.15-5.073a.5.5 0 0 1 .704-.07"/></svg> Statistiques du Joueur #@selectedPlayerStats.Player?.CharacterId</h5>
                        <button type="button" class="btn-close" @onclick="ClosePlayerStats"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Informations du joueur</h6>
                                <p><strong>Santé:</strong> @selectedPlayerStats.Player?.Health.ToString("F1")</p>
                                <p><strong>Force:</strong> @selectedPlayerStats.Player?.Strength.ToString("F1")</p>
                                <p><strong>Armure:</strong> @selectedPlayerStats.Player?.Armor.ToString("F1")</p>
                                <p><strong>Dégâts:</strong> @selectedPlayerStats.Player?.Damage.ToString("F1")</p>
                                <p><strong>Coeurs:</strong> <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314"/></svg> @selectedPlayerStats.Player?.HeartNumber</p>
                            </div>
                            <div class="col-md-6">
                                <h6>Statistiques de jeu</h6>
                                <p><strong>Parties jouées:</strong> @selectedPlayerStats.Statistics?.TotalGames</p>
                                <p><strong>Victoires:</strong> <span class="text-success">@selectedPlayerStats.Statistics?.Victories</span></p>
                                <p><strong>Défaites:</strong> <span class="text-danger">@selectedPlayerStats.Statistics?.Defeats</span></p>
                                <p><strong>Score total:</strong> @selectedPlayerStats.Statistics?.TotalScore</p>
                                <p><strong>Meilleur score:</strong> @selectedPlayerStats.Statistics?.BestScore</p>
                                <p><strong>Score moyen:</strong> @selectedPlayerStats.Statistics?.AverageScore?.ToString("F1")</p>
                                <p><strong>Taux de victoire:</strong> @selectedPlayerStats.Statistics?.WinRate?.ToString("F1")%</p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="ClosePlayerStats">Fermer</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string activeTab = "players";
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;

    private List<PlayerDto>? players;
    private List<LeaderboardEntry>? leaderboard;
    private List<GameSessionDto>? sessions;
    private StatisticsDto? statistics;
    private PlayerStatsDto? selectedPlayerStats;

    private const string API_BASE_URL = "api/Admin";

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            await Task.WhenAll(
                LoadPlayers(),
                LoadLeaderboard(),
                LoadSessions(),
                LoadStatistics()
            );
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement des données: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPlayers()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<PlayersResponse>($"{API_BASE_URL}/players");
            players = response?.Data;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement des joueurs: {ex.Message}";
        }
    }

    private async Task LoadLeaderboard()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<LeaderboardResponse>($"{API_BASE_URL}/leaderboard?top=50");
            leaderboard = response?.Data;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement du classement: {ex.Message}";
        }
    }

    private async Task LoadSessions()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<SessionsResponse>($"{API_BASE_URL}/sessions");
            sessions = response?.Data;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement des sessions: {ex.Message}";
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            statistics = await Http.GetFromJsonAsync<StatisticsDto>($"{API_BASE_URL}/statistics");
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement des statistiques: {ex.Message}";
        }
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        successMessage = null;
        errorMessage = null;
    }


    private async Task ViewPlayerStats(int playerId)
    {
        try
        {
            selectedPlayerStats = await Http.GetFromJsonAsync<PlayerStatsDto>($"{API_BASE_URL}/players/{playerId}/stats");
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement des statistiques: {ex.Message}";
        }
    }

    private void ClosePlayerStats()
    {
        selectedPlayerStats = null;
    }


    // DTOs
    public class PlayerDto
    {
        public int CharacterId { get; set; }
        public double Health { get; set; }
        public double Strength { get; set; }
        public double Armor { get; set; }
        public double Damage { get; set; }
        public int HeartNumber { get; set; }
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class LeaderboardEntry
    {
        public int PlayerId { get; set; }
        public int TotalScore { get; set; }
        public int GamesPlayed { get; set; }
        public int Victories { get; set; }
        public int Defeats { get; set; }
        public int BestScore { get; set; }
        public double AverageScore { get; set; }
        public DateTime LastPlayed { get; set; }
    }

    public class GameSessionDto
    {
        public int SessionId { get; set; }
        public int PlayerId { get; set; }
        public int DungeonId { get; set; }
        public int Score { get; set; }
        public string? Status { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }

    public class StatisticsDto
    {
        public EntityCountsDto? EntityCounts { get; set; }
        public PlayerStatisticsDto? PlayerStatistics { get; set; }
        public SessionStatisticsDto? SessionStatistics { get; set; }
    }

    public class EntityCountsDto
    {
        public int Rooms { get; set; }
        public int Players { get; set; }
        public int Monsters { get; set; }
        public int Dungeons { get; set; }
        public int TotalSessions { get; set; }
    }

    public class PlayerStatisticsDto
    {
        public int AlivePlayers { get; set; }
        public int DeadPlayers { get; set; }
        public double? AverageHealth { get; set; }
        public double? AverageStrength { get; set; }
    }

    public class SessionStatisticsDto
    {
        public int ActiveSessions { get; set; }
        public int CompletedSessions { get; set; }
        public int AbandonedSessions { get; set; }
        public int SavedSessions { get; set; }
        public double? AverageScore { get; set; }
    }

    public class PlayerStatsDto
    {
        public PlayerDto? Player { get; set; }
        public GameStatisticsDto? Statistics { get; set; }
    }

    public class GameStatisticsDto
    {
        public int TotalGames { get; set; }
        public int GamesInProgress { get; set; }
        public int Victories { get; set; }
        public int Defeats { get; set; }
        public int Abandoned { get; set; }
        public int TotalScore { get; set; }
        public int BestScore { get; set; }
        public double? AverageScore { get; set; }
        public double? WinRate { get; set; }
        public DateTime? LastPlayed { get; set; }
    }

    public class PlayersResponse
    {
        public int Count { get; set; }
        public List<PlayerDto>? Data { get; set; }
    }

    public class LeaderboardResponse
    {
        public int Count { get; set; }
        public List<LeaderboardEntry>? Data { get; set; }
    }

    public class SessionsResponse
    {
        public int Count { get; set; }
        public List<GameSessionDto>? Data { get; set; }
    }
}
