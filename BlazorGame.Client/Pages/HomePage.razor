@page "/home"
@inject NavigationManager Navigation

<PageTitle>Bladebound · Accueil</PageTitle>

<div class="home-container">
    <div class="left-side">
        <h4>
            Prêt pour le <span class="highlight">défi</span> ?
        </h4>
        <p>Entre dans l'arène.</p>
        <div class="home-actions">
            <button class="btn btn-primary" @onclick="HandleStart">Nouvelle aventure</button>
            <button class="btn btn-outline-secondary" @onclick="HandleLoadGame">Reprendre une partie</button>
        </div>
    </div>
    <div class="right-side">
        <img src="images/icons/hero-icon.png" alt="Icône du joueur" />
    </div>
</div>

@code {

    /// <summary>
    /// Navigue vers une nouvelle partie.
    /// </summary>
    private void HandleStart()
    {
        Navigation.NavigateTo("/new-adventure");
    }

    /// <summary>
    /// Navigue vers les parties sauvegardées.
    /// </summary>
    private void HandleLoadGame()
    {
        Navigation.NavigateTo("/saved-games");
    }
}